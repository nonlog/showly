<?xml version="1.0" encoding="utf-8"?>
<merge
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  tools:parentTag="android.widget.FrameLayout">

  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/mediaShowCompactRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="88dp"
    android:paddingVertical="6dp">

    <ImageView
      android:id="@+id/mediaShowCompactImage"
      android:layout_width="52dp"
      android:layout_height="76dp"
      android:background="@drawable/bg_media_view_elevation"
      android:elevation="@dimen/elevationSmall"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

    <ImageView
      android:id="@+id/mediaShowCompactPlaceholder"
      android:layout_width="52dp"
      android:layout_height="76dp"
      android:background="@drawable/bg_media_view_placeholder"
      android:padding="14dp"
      android:visibility="gone"
      app:layout_constraintBottom_toBottomOf="@id/mediaShowCompactImage"
      app:layout_constraintEnd_toEndOf="@id/mediaShowCompactImage"
      app:layout_constraintStart_toStartOf="@id/mediaShowCompactImage"
      app:layout_constraintTop_toTopOf="@id/mediaShowCompactImage"
      app:srcCompat="@drawable/ic_television"
      app:tint="?attr/colorPlaceholderIcon"
      tools:visibility="visible" />

    <ProgressBar
      android:id="@+id/mediaShowCompactProgress"
      style="@style/ProgressBar.Dark"
      android:layout_width="24dp"
      android:layout_height="24dp"
      android:visibility="gone"
      app:layout_constraintBottom_toBottomOf="@id/mediaShowCompactImage"
      app:layout_constraintEnd_toEndOf="@id/mediaShowCompactImage"
      app:layout_constraintStart_toStartOf="@id/mediaShowCompactImage"
      app:layout_constraintTop_toTopOf="@id/mediaShowCompactImage"
      tools:visibility="visible" />

    <TextView
      android:id="@+id/mediaShowCompactTitle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spaceMedium"
      android:ellipsize="end"
      android:maxLines="2"
      android:textColor="?android:attr/textColorPrimary"
      android:textSize="15sp"
      android:textStyle="bold"
      app:layout_constraintBottom_toTopOf="@id/mediaShowCompactSubtitle"
      app:layout_constraintEnd_toStartOf="@id/mediaShowCompactRating"
      app:layout_constraintStart_toEndOf="@id/mediaShowCompactImage"
      app:layout_constraintTop_toTopOf="@id/mediaShowCompactImage"
      app:layout_constraintVertical_chainStyle="packed"
      tools:text="Game of Thrones" />

    <TextView
      android:id="@+id/mediaShowCompactSubtitle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/spaceMedium"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="?android:attr/textColorSecondary"
      android:textSize="12sp"
      app:layout_constraintBottom_toBottomOf="@id/mediaShowCompactImage"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toEndOf="@id/mediaShowCompactImage"
      app:layout_constraintTop_toBottomOf="@id/mediaShowCompactTitle"
      tools:text="HBO · 2011" />

    <TextView
      android:id="@+id/mediaShowCompactRating"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:drawablePadding="2dp"
      android:gravity="center_vertical"
      android:textColor="?android:attr/textColorSecondary"
      android:textSize="12sp"
      app:drawableStartCompat="@drawable/ic_star"
      app:drawableTint="?attr/colorAccent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toTopOf="@id/mediaShowCompactTitle"
      tools:text="9.2" />

  </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
